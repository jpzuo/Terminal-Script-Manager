{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Terminal Script Manager",
  "version": "1.0.6",
  "identifier": "com.zjp.terminal-script-manager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "title": "终端脚本管理器",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "connect-src": "'self' tauri: https://api.github.com https://gist.githubusercontent.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ZJP",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "shortDescription": "Terminal Script Manager",
    "longDescription": "A powerful terminal script management tool"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNDcwMjQyOEI2RjlEQjUKUldTMW5XK0xRZ0pIbzBCQzVFUXpVaWNPQWJFcnk3Q3lxUGNxTDl0RVY3ZFFoS0NkaE5HK2FydUcK",
      "endpoints": [
        "https://github.com/jpzuo/Terminal-Script-Manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
